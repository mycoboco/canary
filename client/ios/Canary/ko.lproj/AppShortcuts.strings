/* Play Playlist */
"Play ${playlist} in ${applicationName}" = "${applicationName}에서 ${playlist} 재생";
"Play the ${playlist} playlist in ${applicationName}" = "${applicationName}에서 ${playlist} 틀어줘";
"${applicationName} playlist ${playlist}" = "${applicationName} 재생목록 ${playlist}";
"Play a playlist in ${applicationName}" = "${applicationName} 재생목록 재생";

/* Start Playing */
"Play in ${applicationName}" = "${applicationName} 재생";
"Start playing in ${applicationName}" = "${applicationName} 재생 시작";

/* Play or Pause */
"Pause ${applicationName}" = "${applicationName} 일시정지";
"Resume ${applicationName}" = "${applicationName} 다시 재생";

/* Next Track */
"Next song in ${applicationName}" = "${applicationName} 다음 곡";

/* Previous Track */
"Previous song in ${applicationName}" = "${applicationName} 이전 곡";

/* Shuffle On (셔플 / 랜덤) */
"Turn on shuffle in ${applicationName}" = "${applicationName} 셔플 켜줘";
"Shuffle on in ${applicationName}" = "${applicationName} 랜덤 켜줘";

/* Shuffle Off */
"Turn off shuffle in ${applicationName}" = "${applicationName} 셔플 꺼줘";
"Shuffle off in ${applicationName}" = "${applicationName} 랜덤 꺼줘";

/* Repeat All (전체 반복) */
"Repeat all in ${applicationName}" = "${applicationName} 전체 반복";
"Repeat everything in ${applicationName}" = "${applicationName} 전곡 반복";

/* Repeat One (1곡 반복) */
"Repeat one in ${applicationName}" = "${applicationName} 한 곡 반복";
"Repeat this song in ${applicationName}" = "${applicationName} 1곡 반복";

/* Repeat Off (반복 꺼줘) */
"Turn off repeat in ${applicationName}" = "${applicationName} 반복 꺼줘";
"Stop repeating in ${applicationName}" = "${applicationName} 반복 끄기";

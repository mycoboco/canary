/* Play Playlist */
"Play ${playlist} in ${applicationName}" = "${applicationName}에서 ${playlist} 재생";
"Play the ${playlist} playlist in ${applicationName}" = "${applicationName}에서 ${playlist} 틀어줘";
"${applicationName} playlist ${playlist}" = "${applicationName} 재생목록 ${playlist}";
"Play a playlist in ${applicationName}" = "${applicationName} 재생목록 재생";

/* Start Playing */
"Play in ${applicationName}" = "${applicationName} 재생";
"Start playing in ${applicationName}" = "${applicationName} 재생 시작";

/* Play or Pause */
"Pause ${applicationName}" = "${applicationName} 일시정지";
"Resume ${applicationName}" = "${applicationName} 다시 재생";

/* Next Track */
"Next song in ${applicationName}" = "${applicationName} 다음 곡";

/* Previous Track */
"Previous song in ${applicationName}" = "${applicationName} 이전 곡";
